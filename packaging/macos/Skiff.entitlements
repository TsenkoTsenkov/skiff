<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements of the Developer ID build (hardened runtime).

     Only one is needed: sending Apple events, for "open in terminal"
     (osascript driving Terminal or iTerm). Metal, TLS, the login shell and
     kubeconfig exec plugins need none.

     Deliberately absent: App Sandbox (it would cut off ~/.kube and the
     credential plugins), disable-library-validation, JIT and unsigned
     executable memory. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key><true/>
</dict>
</plist>
